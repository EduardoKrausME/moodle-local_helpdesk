{{!
    @template local_helpdesk/mcp_banner
}}
<aside class="mcp-promo" aria-labelledby="local_helpdesk-mcp-title">
    <div class="mcp-promo__icon" aria-hidden="true">MCP</div>
    <div class="mcp-promo__content">
        <span class="mcp-promo__badge">{{#str}}mcp_banner_badge,local_helpdesk{{/str}}</span>
        <h3 id="local_helpdesk-mcp-title">{{#str}}mcp_banner_title,local_helpdesk{{/str}}</h3>
        <p>{{#str}}mcp_banner_description,local_helpdesk{{/str}}</p>
        <ul>
            <li>{{#str}}mcp_banner_benefit_discovery,local_helpdesk{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_security,local_helpdesk{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_control,local_helpdesk{{/str}}</li>
        </ul>
        <a class="mcp-promo__link" href="https://eduardokrausme.github.io/moodle-local_mcp/"
           target="_blank" rel="noopener noreferrer">{{#str}}mcp_banner_cta,local_helpdesk{{/str}} &#8599;</a>
    </div>
    <form class="mcp-promo__close" method="post" action="{{mcp_banner_dismiss_url}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="dismiss_mcp_banner" value="1">
        <button class="mcp-promo__dismiss" type="submit"
            aria-label="{{#str}}mcp_banner_dismiss,local_helpdesk{{/str}}"
            title="{{#str}}mcp_banner_dismiss,local_helpdesk{{/str}}">&times;</button>
    </form>
</aside>
